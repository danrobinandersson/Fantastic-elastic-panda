# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Centralbank / Tivoli API
VITE_CENTRALBANK_API_URL=https://api-develop-b059.up.railway.app
VITE_TIVOLI_API_KEY=your-tivoli-api-key-here

# Optional: Local dev proxy (if running scoreboard-api locally)
VITE_TIVOLI_PROXY_BASE=http://localhost:3001/tivoli

# Mock API for testing (set to true to use mock data)
VITE_USE_MOCK_API=false
